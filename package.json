{
  "name": "jarvix-meeting-assistant",
  "productName": "JARVIX Meeting Assistant",
  "version": "1.0.0",
  "description": "Real-time transcription and summary assistant using OpenAI",
  "main": "dist-electron/app/electron/main.js",
  "author": "JARVIX",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && cross-env VITE_DEV=1 concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "electron dist-electron/app/electron/main.dev.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "build": "npm run build:electron && vite build",
    "build:electron": "node build-electron.js",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.jarvix.meeting-assistant",
    "productName": "JARVIX Meeting Assistant",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app uses the microphone for real-time transcription and summarization."
      },
      "artifactName": "JARVIX-${arch}.dmg"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      },
      "artifactName": "JARVIX-Setup.exe"
    },
    "afterSign": "build/notarize.js",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ]
  }
}
